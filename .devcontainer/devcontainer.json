{
  // Codespace di GitHub: gira sui server di GitHub, non serve Docker sul tuo PC.
  // Primo avvio: ~10-15 minuti (installa COLMAP, OpenMVS e le dipendenze).
  "name": "Scan3D",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  // `;` e `exit 0`: se un passo fallisce, Codespaces SALTEREBBE i comandi successivi (incluso l'avvio
  // automatico). Gli errori restano nei log; codespace-start.sh ripara da solo ciò che manca.
  "postCreateCommand": "mkdir -p .cache; (bash scripts/setup-linux-tools.sh; npm run setup; npm run hooks) 2>&1 | tee -a .cache/postcreate.log; exit 0",
  // A ogni accensione e a ogni apertura: avvia app + API e rende pubblica la porta 8000 (log in .cache/).
  // Lo script è sicuro da lanciare più volte (lock + controllo /api/health): niente doppioni.
  // In background, così il Codespace è subito usabile mentre il server si prepara.
  "postStartCommand": "mkdir -p .cache && setsid nohup bash scripts/codespace-start.sh >> .cache/codespace-start.log 2>&1 < /dev/null &",
  "postAttachCommand": "mkdir -p .cache && setsid nohup bash scripts/codespace-start.sh >> .cache/codespace-start.log 2>&1 < /dev/null &",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "Scan3D (app + API)", "onAutoForward": "notify" },
    "5173": { "label": "Vite (sviluppo)", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}

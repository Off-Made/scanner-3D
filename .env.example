# Copia questo file in .env e compila i valori. NON committare .env.
# PIN di accesso (6+ cifre). Se vuoto, il server ne genera uno all'avvio e lo stampa nel terminale.
ACCESS_PIN=
# Segreto per firmare i token di sessione. Se vuoto, viene generato all'avvio (i token scadono al riavvio).
SESSION_SECRET=
# Durata del token in ore
TOKEN_TTL_HOURS=12
# Origini autorizzate per CORS, separate da virgola (es. il dominio Vercel). Vuoto = solo stessa origine.
CORS_ORIGINS=
# Proxy fidati da cui accettare gli header con l'IP reale (IP o CIDR, separati da virgola). Loopback è sempre fidato.
TRUSTED_PROXIES=
# Header da cui leggere l'IP reale, in ordine di priorità
TRUSTED_IP_HEADERS=CF-Connecting-IP,X-Forwarded-For
# URL del backend per il frontend su Vercel (vuoto in locale: si usa il proxy di Vite)
VITE_API_URL=
# Token Hugging Face (fase 4, opzionale)
HF_TOKEN=
